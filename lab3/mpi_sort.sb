#!/bin/bash
#SBATCH --job-name="mpi_sort"
#SBATCH --output="mpi_sort.%j.%N.out"
#SBATCH --error=mpi_sort.%j.err
#SBATCH --partition=debug
#SBATCH --nodes=2
#SBATCH --ntasks=8
#SBATCH --ntasks-per-node=4
#SBATCH --mem=8G
#SBATCH --account="slo106"
#SBATCH --export=ALL
#SBATCH --time=00:05:00

set -euo pipefail

module purge
module load cpu/0.15.4
module load gcc/10.2.0
module load python/3.8.5
module load openmpi/4.0.4
module load py-mpi4py/3.0.3
module load slurm

cd "$SLURM_SUBMIT_DIR"

N="${1:?Usage: sbatch mpi_sort.sb <N>}"

srun --mpi=pmi2 -n "$SLURM_NTASKS" python -u mpi_sort.py "$N"